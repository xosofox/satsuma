{
  "name": "satsuma",
  "version": "1.0.0",
  "description": "Dependency-free pan and pinch zoom for HTML content",
  "main": "./dist/satsuma.js",
  "module": "./dist/satsuma.js",
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-demo.js",
    "preview": "vite preview --outDir demo --host 0.0.0.0 --port 9124",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "test:browser": "node tests/browser.cjs",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xosofox/satsuma.git"
  },
  "keywords": [
    "pan",
    "pinch",
    "zoom",
    "touch"
  ],
  "author": "Peter Dietrich",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/xosofox/satsuma/issues"
  },
  "homepage": "https://github.com/xosofox/satsuma#readme",
  "devDependencies": {
    "eslint": "^10.14.0",
    "playwright": "^1.65.0",
    "vite": "^8.3.6"
  },
  "type": "module",
  "exports": {
    ".": "./dist/satsuma.js"
  },
  "files": [
    "dist",
    "src/Satsuma.js",
    "src/Translator.js",
    "src/TranslatorUpdate.js",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  }
}
